-- ---------------------------------------------------------------------
-- 4. PERMISOS GENERALES (Evita errores 'permission denied')
-- ---------------------------------------------------------------------
grant usage on schema public to anon, authenticated;

grant all on table public.vehiculos to anon, authenticated;
grant all on table public.vehiculos_historial to anon, authenticated;
grant all on table public.puestos_historial to anon, authenticated;

grant usage, select on all sequences in schema public to anon, authenticated;


-- ---------------------------------------------------------------------
-- 5. TRIGGERS AUTOMÁTICOS PARA REGISTRO DE CAMBIOS
-- ---------------------------------------------------------------------

-- Trigger para vehiculos
create or replace function public.tr_auditoria_vehiculos()
returns trigger as $$
begin
  if (TG_OP = 'INSERT') then
    insert into public.vehiculos_historial(vehiculo_id, accion, descripcion, datos_nuevos)
    values (NEW.id, 'CREACIÓN', 'Vehículo registrado', to_jsonb(NEW));
    return NEW;
  elsif (TG_OP = 'UPDATE') then
    insert into public.vehiculos_historial(vehiculo_id, accion, descripcion, datos_anteriores, datos_nuevos)
    values (NEW.id, 'EDICIÓN', 'Vehículo modificado', to_jsonb(OLD), to_jsonb(NEW));
    return NEW;
  elsif (TG_OP = 'DELETE') then
    insert into public.vehiculos_historial(vehiculo_id, accion, descripcion, datos_anteriores)
    values (OLD.id, 'ELIMINACIÓN', 'Vehículo eliminado', to_jsonb(OLD));
    return OLD;
  end if;
  return null;
end;
$$ language plpgsql;

drop trigger if exists trigger_auditoria_vehiculos on public.vehiculos;
create trigger trigger_auditoria_vehiculos
after insert or update or delete on public.vehiculos
for each row execute function public.tr_auditoria_vehiculos();

-- Trigger para puestos
create or replace function public.tr_auditoria_puestos()
returns trigger as $$
begin
  if (TG_OP = 'INSERT') then
    insert into public.puestos_historial(puesto_id, accion, datos_nuevos)
    values (NEW.id, 'CREACIÓN', to_jsonb(NEW));
    return NEW;
  elsif (TG_OP = 'UPDATE') then
    insert into public.puestos_historial(puesto_id, accion, datos_anteriores, datos_nuevos)
    values (NEW.id, 'EDICIÓN', to_jsonb(OLD), to_jsonb(NEW));
    return NEW;
  elsif (TG_OP = 'DELETE') then
    insert into public.puestos_historial(puesto_id, accion, datos_anteriores)
    values (OLD.id, 'ELIMINACIÓN', to_jsonb(OLD));
    return OLD;
  end if;
  return null;
end;
$$ language plpgsql;

drop trigger if exists trigger_auditoria_puestos on public.puestos;
create trigger trigger_auditoria_puestos
after insert or update or delete on public.puestos
for each row execute function public.tr_auditoria_puestos();